{
    admin off
    persist_config off
}
:8787 {
    # Serve static files from /app
    root * /app

    # Enable the CLI in its own path
    handle_path /tty/* {
        reverse_proxy localhost:7681
    }

    # Serve images used in learning materials
    handle_path /imgs/* {
        root * /app/content/imgs
        file_server
    }

    # By default all is served as a file
    file_server
}
